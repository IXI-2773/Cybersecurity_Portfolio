| makemv delim=";" fixture_rows
| mvexpand fixture_rows
| eval parts=split(fixture_rows,"|")
| eval timestamp=mvindex(parts,0), username=mvindex(parts,1), source_ip=mvindex(parts,2), host=mvindex(parts,3), event_type=mvindex(parts,4), scenario=mvindex(parts,5)
| fields - fixture_rows parts
| eventstats count as fixture_event_count dc(scenario) as fixture_scenario_count
| where event_type="login_failure" OR event_type="login_success"
| eval _time=strptime(replace(timestamp,"Z$","+0000"),"%Y-%m-%dT%H:%M:%S%z")
| sort 0 _time
| streamstats current=f count(eval(event_type="login_success")) as prior_successes by username source_ip
| fillnull value=0 prior_successes
| streamstats time_window=10m count(eval(event_type="login_failure")) as recent_failures by username source_ip prior_successes
| where event_type="login_success" AND recent_failures>=5
| rename recent_failures as failure_count_in_window
| table timestamp username source_ip scenario failure_count_in_window fixture_event_count fixture_scenario_count
